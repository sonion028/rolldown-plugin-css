{
  "name": "rolldown-plugin-css",
  "version": "0.1.0",
  "private": false,
  "description": "Rolldown CSS plugin: Sass/Scss/Less compilation, CSS Modules & compatibility via Lightning CSS, auto-injecting CSS imports into JS.",
  "keywords": [
    "css",
    "less",
    "lightningCSS",
    "rolldown",
    "rolldown-plugin",
    "sass"
  ],
  "bugs": {
    "url": "https://github.com/sonion028/rolldown-plugin-css/issues"
  },
  "license": "MIT",
  "author": "sonion",
  "repository": "https://github.com/sonion028/rolldown-plugin-css",
  "type": "module",
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "types": "./dist/types/index.d.mts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "preinstall": "npm run sync:node-version && (npx -y only-allow pnpm || exit 1)",
    "prepare": "npx simple-git-hooks",
    "sync:node-version": "node scripts/sync-node-version/index.js",
    "lint": "eslint '{src,apps,packages}/**/*.{ts,tsx,js,jsx,vue}'",
    "lint:fix": "eslint '{src,apps,packages}/**/*.{ts,tsx,js,jsx,vue}' --fix",
    "lint:error": "eslint '{src,apps,packages}/**/*.{ts,tsx,js,jsx,vue}' --quiet",
    "lint:spell": "cspell lint '{src,apps,packages}/**/*.{js,ts,jsx,tsx,mjs,cjs,json,css,less,scss,vue,html,md}'",
    "fmt": "oxfmt '{src,packages,apps}/**/*.*'",
    "fmt:check": "oxfmt --check '{src,packages,apps}/**/*.*'",
    "check": "npx tsc --noEmit && npm run lint && npm run fmt:check && npm run lint:spell",
    "fix": "npm run lint:fix && npm run fmt"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@types/less": "^3.0.8",
    "@types/node": "^25.6.2",
    "cspell": "^10.0.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.9.0",
    "globals": "^17.6.0",
    "less": "^4.6.4",
    "lightningcss": "^1.32.0",
    "lint-staged": "^17.0.5",
    "only-allow": "^1.2.2",
    "oxfmt": "^0.50.0",
    "rimraf": "^6.1.3",
    "rolldown": "1.0.1",
    "sass": "^1.99.0",
    "sass-embedded": "^1.99.0",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "peerDependencies": {
    "less": "^4.6.4",
    "lightningcss": "^1.32.0",
    "rolldown": ">=1.0.0",
    "sass": "^1.98.0",
    "sass-embedded": "^1.98.0"
  },
  "engines": {
    "node": ">=22.22.3",
    "pnpm": "^10.33.4"
  },
  "$schema": "https://raw.githubusercontent.com/vitejs/vite-plugin-registry/refs/heads/main/data/schema/extended-package-json.schema.json",
  "compatiblePackages": {
    "schemaVersion": 1,
    "rolldown": {
      "type": "compatible",
      "versions": ">=1.0.0"
    },
    "vite": {
      "type": "compatible",
      "versions": ">=7.0.0",
      "note": "For usage in Vite, please refer to the README.md."
    },
    "rollup": {
      "type": "unknown"
    }
  }
}